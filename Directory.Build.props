<Project>
  <PropertyGroup>
    <!-- MAJOR.MINOR are maintained here. PATCH comes from CI: -p:BuildNumber=<github.run_number> -->
    <VersionPrefixBase>0.1</VersionPrefixBase>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <VersionPrefix>$(VersionPrefixBase).$(BuildNumber)</VersionPrefix>
  </PropertyGroup>
</Project>
